# ========================================================
# AttendPro Environment Configuration
# All service ports and URLs can be modified here
# ========================================================

# Main Express API Backend Port
PORT=5050

# Guard Terminal Microservice Port
GUARD_PORT=5051

# Web Frontend Port (Vite)
CLIENT_PORT=5173

# Frontend URLs (Used for CORS and linking)
FRONTEND_URL=http://localhost:5173
GUARD_FRONTEND_URL=http://localhost:5051

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_db

# Security & Tokens
JWT_SECRET=super_secret_jwt_key_attendpro_2026
JWT_GUARD_SECRET=guard_secret_jwt_key_attendpro_2026
JWT_EXPIRES_IN=8h
JWT_GUARD_EXPIRES_IN=12h

# Backups & File Storage
BACKUP_DIR=./backups
NODE_ENV=development
